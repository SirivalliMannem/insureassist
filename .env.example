# ==============================================================================
# InsureAssist Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=insureassist
POSTGRES_PASSWORD=Test@123
POSTGRES_DB=insureassist
DATABASE_URL=postgresql://insureassist:Test%40123@postgres:5432/insureassist

# Security & Authentication
JWT_SECRET_KEY=insureassist-super-secret-jwt-key-for-development-mode
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / Groq Configuration (AI Service)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
USE_MOCK_GROQ=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,*
