# ==============================================================================
# InsureAssist Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=insureassist
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=insureassist
POSTGRES_PORT=5435
DATABASE_URL=postgresql://insureassist:your_postgres_password_here@postgres:5432/insureassist

# Security & Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Microservice Ports
AUTH_SERVICE_PORT=8001
CUSTOMER_SERVICE_PORT=8002
AGENT_SERVICE_PORT=8003
UNDERWRITER_SERVICE_PORT=8004
ADMIN_SERVICE_PORT=8005
AI_SERVICE_PORT=8006

# LLM / Groq Configuration (AI Service)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
USE_MOCK_GROQ=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,*
